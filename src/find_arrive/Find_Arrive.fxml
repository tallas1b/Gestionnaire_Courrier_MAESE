                  </Pane>
						<TableView fx:id="table" layoutX="34.0" layoutY="227.0" prefHeight="254.0" prefWidth="950.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
							<columns>
								<TableColumn fx:id="colonne_numero_arrive" prefWidth="38.0" text="N°" />
                        <TableColumn fx:id="colonne_numero_ordre" prefWidth="63.0" text="N° Ordre" />
								<TableColumn fx:id="colonne_expediteur" prefWidth="115.0" text="Expediteur" />
								<TableColumn fx:id="colone_Mention" prefWidth="81.0" text="Mention" />
                        <TableColumn fx:id="colonne_nom_fichier" prefWidth="99.0" text="Nom Fichier" />
                        <TableColumn fx:id="colone_date" prefWidth="81.0" text="Date" />
                        <TableColumn fx:id="crypto_systeme" prefWidth="88.0" text="Cryptosysteme" />
                        <TableColumn fx:id="colone_objet" prefWidth="380.0" text="Objet Message" />
							</columns>
						</TableView>
