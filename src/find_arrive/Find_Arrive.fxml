                              <Label layoutX="10.0" layoutY="12.0" styleClass="light_blue_text_style" text="Expediteur :" GridPane.rowIndex="1" />
                              <TextField fx:id="text_expediteur_diplomail" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>
                        <AnchorPane layoutX="139.0" layoutY="100.0" prefHeight="110.0" prefWidth="539.0">
                           <children>
                              <Pane fx:id="pane_criter_objet" prefHeight="108.0" prefWidth="539.0" styleClass="lighter_dark_blue">
                                 <children>
                                    <Label layoutX="101.0" layoutY="7.0" styleClass="light_blue_text_style" text="Rechercher Suivant Objet ( un mot max )" />
                                    <TextField fx:id="textfield_objet" layoutX="121.0" layoutY="43.0" prefHeight="25.0" prefWidth="261.0" promptText="Objet" />
                                 </children>
                              </Pane>
                              <Pane fx:id="pane_criter_numero_arrive" prefHeight="108.0" prefWidth="397.0" styleClass="lighter_dark_blue" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <children>
                                    <TextField fx:id="textfield_numero_arrive" layoutX="140.0" layoutY="50.0" prefHeight="25.0" prefWidth="225.0" />
                                    <Label layoutX="99.0" layoutY="7.0" styleClass="light_blue_text_style" text="Rechercher Suivant Numero d'ordre arrivé" />
