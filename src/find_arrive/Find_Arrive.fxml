<AnchorPane prefHeight="650.0" prefWidth="950.0" stylesheets="@../application/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="find_arrive.Find_Arrive_Controller">
	<children>
		<AnchorPane prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
			<children>
				<Pane prefHeight="75.0" prefWidth="200.0" styleClass="dark_blue" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
					<children>
						<Label layoutX="180.0" layoutY="26.0" styleClass="light_blue_text_style" text="Rechercher un message Arrivé" />
						<ImageView fitHeight="70.0" fitWidth="80.0" layoutX="75.0" layoutY="3.0" pickOnBounds="true" preserveRatio="true">
							<image>
								<Image url="@../images/icons8_find_user_male_100px.png" />
							</image>
						</ImageView>
					</children>
				</Pane>
				<AnchorPane prefHeight="200.0" prefWidth="200.0" styleClass="lighter_dark_blue" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="75.0">
					<children>
                  <Pane layoutX="28.0" layoutY="22.0" prefHeight="235.0" prefWidth="900.0" styleClass="transparent_light_white" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0">
                     <children>
      						<Button layoutX="725.0" layoutY="137.0" mnemonicParsing="false" onAction="#on_rechercher_clicked" prefHeight="27.0" prefWidth="140.0" text="Rechercher Message">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Button>
                        <GridPane hgap="20.0" layoutX="152.0" layoutY="14.0" vgap="10.0">
